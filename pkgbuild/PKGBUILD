# Maintainer: Prime Agent contributors
# Maintainer-facing local PKGBUILD. Build the parent repository's stable ref,
# verify the selected revision; do not package the parent working tree.
_repo_root=$(realpath -e ..)
_source_commit=$(git -C "$_repo_root" rev-parse refs/heads/stable)
_release_dir() {
    local version
    version=$(sed -n 's/^version *= *"\([^" ]*\)".*/\1/p' "$srcdir/$pkgname/Cargo.toml" | head -1) || return
    printf '%s/target/release-package/prime-agent-%s-linux-x64' "$srcdir/$pkgname" "$version"
}
pkgname=prime-agent
pkgver=0.10.0.r2.g2da0c33
pkgrel=1
pkgdesc='Self-improving coding and research agent with a persistent Python kernel'
arch=('x86_64')
url='https://github.com/PrimeIntellect-ai/prime-agent'
license=('MIT')
depends=('python>=3.11' 'uv' 'xonsh' 'python-dill' 'python-httpx2' 'python-mcp' 'python-tyro')
makedepends=('cargo' 'git' 'make' 'python' 'binutils')
optdepends=('python-httpx: websearch skill' 'python-pillow: attach-image skill')
source=("$pkgname::git+file://$_repo_root#branch=stable")
sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/$pkgname" || return
    ( set -o pipefail
      git describe --long --tags --abbrev=7 2>/dev/null | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' ||
      printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
    )
}

prepare() {
    local source_commit
    cd "$srcdir/$pkgname" || return

    source_commit=$(git rev-parse HEAD) || return
    if [[ "$source_commit" != "$_source_commit" ]]; then
        printf '==> ERROR: source commit mismatch: expected %s, got %s\n' \
            "$_source_commit" "$source_commit" >&2
        return 1
    fi
}

build() {
    cd "$srcdir/$pkgname" || return
    make package CATALOG_ASSETS_MODE=network
}

check() {
    local release_dir
    release_dir=$(_release_dir) || return
    "$release_dir/prime-agent" --version
}

package() {
    local install_dir="$pkgdir/usr/lib/$pkgname"
    local release_dir
    release_dir=$(_release_dir) || return

    install -d "$install_dir"
    cp -a "$release_dir/." "$install_dir/"
    cp -a "$srcdir/$pkgname/docs" "$install_dir/"
    ln -s prime-agent-runtime/src/rlm "$install_dir/rlm"
    install -Dm644 "$srcdir/$pkgname/LICENSE" \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -d "$pkgdir/usr/bin"
    ln -s "/usr/lib/$pkgname/prime-agent" "$pkgdir/usr/bin/$pkgname"
}
