{
	"name": "prime-agent",
	"packageManager": "pnpm@11.22.0",
	"private": true,
	"type": "module",
	"bin": {
		"prime-agent": "./prime-agent.sh"
	},
	"workspaces": [
		"packages/*",
		"packages/coding-agent/examples/extensions/with-deps",
		"packages/coding-agent/examples/extensions/custom-provider-anthropic",
		"packages/coding-agent/examples/extensions/custom-provider-gitlab-duo",
		"packages/coding-agent/examples/extensions/sandbox"
	],
	"scripts": {
		"clean": "pnpm --recursive --filter '!prime-agent' run clean",
		"build": "cd packages/tui && pnpm run build && cd ../ai && pnpm run build && cd ../agent && pnpm run build && cd ../coding-agent && pnpm run build",
		"dev": "concurrently --names \"ai,agent,coding-agent,tui\" --prefix-colors \"cyan,yellow,red,magenta\" \"cd packages/ai && pnpm run dev\" \"cd packages/agent && pnpm run dev\" \"cd packages/coding-agent && pnpm run dev\" \"cd packages/tui && pnpm run dev\"",
		"dev:tsc": "cd packages/ai && pnpm run dev:tsc",
		"check": "biome check --write --error-on-warnings . && tsgo --noEmit && pnpm run check:installer && pnpm run check:installer-owned-prefix && pnpm run check:installer-process-cleanup && pnpm run check:source-launcher && pnpm run check:workspace-scripts && pnpm run check:browser-smoke && pnpm run check:release-workflow",
		"check:installer": "node scripts/check-installer-render.mjs",
		"check:installer-owned-prefix": "node scripts/check-installer-owned-prefix.mjs",
		"check:installer-process-cleanup": "node scripts/check-installer-process-cleanup.mjs",
		"check:source-launcher": "node scripts/check-source-launcher.mjs",
		"check:browser-smoke": "node scripts/check-browser-smoke.mjs",
		"check:release-packages": "node scripts/check-release-package-contract.mjs",
		"check:release-workflow": "node --test scripts/release-workflow.test.mjs",
		"check:workspace-scripts": "node scripts/check-workspace-scripts.mjs",
		"profile:tui": "node scripts/profile-coding-agent-node.mjs --mode tui",
		"profile:rpc": "node scripts/profile-coding-agent-node.mjs --mode rpc",
		"test": "pnpm --recursive --filter '!prime-agent' run test",
		"version:patch": "node scripts/release.mjs",
		"version:minor": "node scripts/release.mjs",
		"version:major": "node scripts/release.mjs",
		"version:set": "node scripts/release.mjs",
		"prepublishOnly": "node scripts/release.mjs",
		"publish": "node scripts/release.mjs",
		"publish:dry": "node scripts/release.mjs",
		"release:pack": "node scripts/pack-prime-agent-release.mjs",
		"release:prepare": "node scripts/prepare-release.mjs",
		"release:dry-run": "node scripts/release-dry-run.mjs",
		"release:test": "node --test scripts/release-command.test.mjs scripts/release-lifecycle.test.mjs scripts/release-publication.test.mjs scripts/release-workflow-contract.test.mjs scripts/release-workflow.test.mjs scripts/safe-release-archive.test.mjs",
		"release:patch": "node scripts/release.mjs",
		"release:minor": "node scripts/release.mjs",
		"release:major": "node scripts/release.mjs",
		"prepare": "husky"
	},
	"devDependencies": {
		"@anthropic-ai/sandbox-runtime": "^0.0.55",
		"@biomejs/biome": "2.5.5",
		"@types/node": "^22.10.5",
		"@typescript/native-preview": "7.0.0-dev.20260120.1",
		"concurrently": "^9.2.4",
		"esbuild": "^0.28.1",
		"husky": "^9.1.7",
		"jiti": "^2.7.0",
		"shx": "^0.4.0",
		"tsx": "^4.23.1",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	},
	"engines": {
		"node": ">=22.8.0"
	},
	"version": "0.8.0",
	"dependencies": {
		"@earendil-works/pi-coding-agent": "^0.8.0",
		"get-east-asian-width": "^1.6.0"
	},
	"overrides": {
		"rimraf": "6.1.2",
		"gaxios": {
			"rimraf": "6.1.2"
		},
		"shell-quote": "^1.10.0"
	}
}
