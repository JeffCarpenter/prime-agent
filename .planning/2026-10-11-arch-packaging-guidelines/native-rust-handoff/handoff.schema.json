{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/prime-agent/handoff-envelope-v1",
  "title": "Query-first handoff envelope v1",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "context",
    "state",
    "sources",
    "facts",
    "known-unknowns",
    "decision",
    "constraints",
    "next"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "context": {
      "type": "object",
      "required": [
        "root",
        "readme",
        "mission",
        "scope",
        "tags"
      ],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "readme": {
          "type": "string",
          "minLength": 1
        },
        "mission": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "scratchpad": {
          "type": "string",
          "minLength": 1,
          "description": "Path from context.root to the authoritative live scratchpad."
        },
        "session_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "description": "Root Prime Agent session UUID for the handoff."
        }
      },
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "required": [
        "status",
        "technical_build_complete",
        "active_build_worker",
        "previous_goal_status",
        "last_attempt"
      ],
      "properties": {
        "status": {
          "type": "string",
          "minLength": 1
        },
        "technical_build_complete": {
          "type": "boolean"
        },
        "active_build_worker": {
          "type": "boolean"
        },
        "previous_goal_status": {
          "type": "string",
          "minLength": 1
        },
        "last_attempt": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "path",
          "role"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "pattern": "^/"
          },
          "role": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "claim",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "additionalProperties": false
      }
    },
    "known-unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "question"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "decision": {
      "type": "object",
      "required": [
        "owner",
        "question",
        "options",
        "required"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "constraints": {
      "type": "object",
      "required": [
        "writes",
        "builds",
        "preservation"
      ],
      "properties": {
        "writes": {
          "type": "string",
          "minLength": 1
        },
        "builds": {
          "type": "string",
          "minLength": 1
        },
        "preservation": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "next": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "when",
          "action",
          "accept"
        ],
        "properties": {
          "when": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "accept": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  }
}
